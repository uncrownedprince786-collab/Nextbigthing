// NextBigThing schema. Every column here is read by the app or written by a data job.

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AssetType {
  stock
  etf
  crypto
  commodity
}

/// marketCap = company market cap (price x shares).
/// fundAssets = ETF/fund size (price x shares outstanding).
/// none = not applicable, so no size figure is stored or shown.
enum CapBasis {
  marketCap
  fundAssets
  none
}

/// How much weight the stored numbers can carry, decided by rule in jobs/confidence.py
/// from how many sources agreed, how many peers the figure was measured against, and
/// whether any required input was missing. It is a description of the evidence, never a
/// prediction.
enum Confidence {
  high
  medium
  low
  none
}

enum SignalSource {
  googleTrends
  wikipedia
  reddit
  hackerNews
  googleNews
  market
}

model Industry {
  id      String   @id @default(dbgenerated("gen_random_uuid()::text"))
  slug    String   @unique
  name    String
  summary String
  sort    Int      @default(0)
  /// Which exchange group this industry belongs to: US, PK, or Global. Ranking only ever
  /// happens inside one industry, so this never mixes currencies in a comparison. It is
  /// what lets the site show the Pakistani sectors as their own list with their own
  /// currency label.
  market  String   @default("US")
  /// ISO code of the currency every size figure in this industry is quoted in.
  currency String  @default("USD")

  assets   Asset[]
  rankings Ranking[]
  analysis Analysis[]
  news     News[]

  createdAt DateTime @default(now())
}

model Asset {
  id          String    @id @default(dbgenerated("gen_random_uuid()::text"))
  industryId  String
  industry    Industry  @relation(fields: [industryId], references: [id], onDelete: Cascade)
  symbol      String
  name        String
  assetType   AssetType
  capBasis    CapBasis  @default(marketCap)
  source      String
  sourceRef   String
  description String?
  /// Text written once per asset by a human. Facts only, no forecasts.
  note        String?
  /// ISO code of the currency close and marketCap are quoted in. Returns are percentages
  /// so they compare across currencies; a size figure does not, and is labelled.
  currency    String    @default("USD")

  snapshots PriceSnapshot[]
  rankings  Ranking[]
  analysis  Analysis[]
  news      News[]
  productLinks ProductAssetLink[]
  eventImpacts EventImpact[]
  humanSignals HumanSignal[]
  signalLogs   SignalLog[]

  createdAt DateTime @default(now())

  @@unique([industryId, symbol])
  @@index([symbol])
}

model PriceSnapshot {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  close     Float
  volume    Float?
  marketCap Float?
  source    String

  @@unique([assetId, date])
  @@index([date])
}

enum RankingBasis {
  /// Size at a past date.
  size
  /// Size today.
  sizeNow
  /// Total return between two dates.
  totalReturn
  /// Relative strength over 12 to 24 months, cross-checked against volume trend.
  rising
}

model Ranking {
  id          String       @id @default(dbgenerated("gen_random_uuid()::text"))
  industryId  String
  industry    Industry     @relation(fields: [industryId], references: [id], onDelete: Cascade)
  assetId     String
  asset       Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  basis       RankingBasis
  periodStart DateTime?    @db.Date
  periodEnd   DateTime     @db.Date
  rank        Int
  sizeRank    Int?
  value       Float
  /// Rule-based evidence grade for this row. See jobs/confidence.py.
  confidence  Confidence  @default(none)
  /// Why the confidence is what it is, in one clause. Shown to the reader.
  confidenceNote String?
  source      String
  note        String?

  @@unique([industryId, basis, periodEnd, assetId])
  @@index([periodEnd])
}

enum AnalysisKind {
  /// One line on what moved between the pre-AI and post-AI snapshots.
  industryShift
  /// Why an asset is where it is now.
  assetPosition
  /// Why an asset is rising.
  assetRising
  /// What current data says may matter next. No prediction certainty.
  forwardLook
  /// Demand read on a product.
  productDemand
  /// Headline for the front page.
  siteLead
  /// What the largest measured moves were in the window after a dated event. The line
  /// reports the moves and never says the event caused them.
  eventImpact
}

model Analysis {
  id          String       @id @default(dbgenerated("gen_random_uuid()::text"))
  kind        AnalysisKind
  industryId  String?
  industry    Industry?    @relation(fields: [industryId], references: [id], onDelete: Cascade)
  assetId     String?
  asset       Asset?       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  eventId     String?
  event       Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  headline    String
  body        String
  /// What is missing, and what would fill it.
  dataNote    String?
  /// Evidence grade carried from the numbers this line was built from.
  confidence  Confidence  @default(none)
  source      String
  createdAt   DateTime     @default(now())

  @@index([kind])
  @@index([industryId])
  @@index([assetId])
  @@index([productId])
  @@index([eventId])
}

model News {
  id          String    @id @default(dbgenerated("gen_random_uuid()::text"))
  industryId  String?
  industry    Industry? @relation(fields: [industryId], references: [id], onDelete: Cascade)
  assetId     String?
  asset       Asset?    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title       String
  url         String
  publisher   String
  publishedAt DateTime
  source      String
  createdAt   DateTime  @default(now())

  // Deduping is per target, not global: the same article can be stored once per asset,
  // once per product, and once for an industry. Prisma cannot express the partial unique
  // indexes that does, so they live in the migration and inserts name them in ON CONFLICT.
  @@index([publishedAt])
  @@index([assetId])
  @@index([productId])
}

model Product {
  id             String   @id @default(dbgenerated("gen_random_uuid()::text"))
  slug           String   @unique
  name           String
  category       String
  summary        String
  /// Wikipedia article title used for the pageview signal.
  wikiTitle      String
  /// Google Trends term. Empty means no Trends data for this product.
  trendsTerm     String
  /// Subreddits searched through the public RSS endpoint. Comma separated.
  subreddits     String
  relatedTickers String
  /// rising, early, flat, or unknown when there is not enough data.
  status         String   @default("unknown")
  demandScore    Float?
  demandNote     String?
  /// Rule-based grade of the demand read. See jobs/confidence.py.
  confidence     Confidence @default(none)
  /// Number of the 5 possible demand sources that returned a usable value.
  sourcesAnswered Int      @default(0)
  /// How many of those sources pointed the same way as the average.
  sourcesAgree    Int      @default(0)
  /// One clause on what the grade is based on.
  confidenceNote  String?
  computedAt     DateTime?

  signals        ProductSignal[]
  assetLinks     ProductAssetLink[]
  analysis       Analysis[]
  news           News[]
  humanSignals   HumanSignal[]
  signalLogs     SignalLog[]
  regions        ProductRegion[]

  createdAt DateTime @default(now())
}

model ProductSignal {
  id        String        @id @default(dbgenerated("gen_random_uuid()::text"))
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  source    SignalSource
  /// Name of the number, for example "reddit_posts_30d" or "wiki_views_wow".
  metric    String
  value     Float?
  /// Evidence link or quoted text. Null when the source has no single item.
  evidence  String?
  periodEnd DateTime      @db.Date
  note      String?
  createdAt DateTime      @default(now())

  @@unique([productId, source, metric, periodEnd])
  @@index([productId, periodEnd])
}

model ProductAssetLink {
  id        String  @id @default(dbgenerated("gen_random_uuid()::text"))
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// Why these are related. Factual description of the relationship only.
  relation  String
  note      String?

  @@unique([productId, assetId])
}

/// A dated, publicly recorded event, seeded by hand from the public record.
///
/// The site measures what the market did in the window after the date. It never says the
/// event caused the move. Two things happening in the same fortnight is a sequence, not a
/// cause, and the only honest claim available from a price series is the size of the move.
model Event {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  slug      String   @unique
  name      String
  /// One or two factual sentences. What happened and when, nothing about what it meant.
  summary   String
  /// The day the event is dated to in the public record.
  date      DateTime @db.Date
  /// conflict, policy, technology, or market.
  category  String
  /// Where the date and the description come from, so a reader can check both.
  source    String
  sourceUrl String
  sort      Int      @default(0)

  impacts  EventImpact[]
  analysis Analysis[]

  createdAt DateTime @default(now())

  @@index([date])
}

/// One asset's measured price move over a window that starts at an event's date.
///
/// Written by jobs/events.py from rows already in PriceSnapshot, so an event window that
/// falls outside the stored history produces no rows rather than an estimate.
model EventImpact {
  id         String   @id @default(dbgenerated("gen_random_uuid()::text"))
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// Length of the measured window in calendar days. 30 unless stated otherwise.
  windowDays Int
  /// The two stored closes the change is computed from, kept so the figure can be checked.
  startDate  DateTime @db.Date
  startClose Float
  endDate    DateTime @db.Date
  endClose   Float
  changePct  Float
  /// Change in 20 day average volume across the same window. Null when the source
  /// published no volume for this asset.
  volumeChangePct Float?
  /// Position within the event, 1 being the largest move by absolute size.
  rank       Int
  confidence Confidence @default(none)
  confidenceNote String?
  source     String

  @@unique([eventId, assetId, windowDays])
  @@index([eventId, rank])
}

/// One row of a public marketplace ranking, as published on the page on the day it was read.
///
/// This is deliberately not a ProductSignal. Attention and marketplace position are
/// different claims: a search trend says people are looking, a bestseller rank says a
/// listing is selling relative to others in its category. Mixing them into one average
/// would hide which of the two a number came from, so marketplace rows are stored apart
/// and never enter the demand score.
model MarketplaceItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()::text"))
  /// Only amazonBestSellers today. eBay is not stored: see brain.md for the verdict.
  marketplace  String
  categorySlug String
  categoryName String
  rank         Int
  title        String
  url          String
  /// Marketplace item id, Amazon's ASIN today. Used to follow one listing between runs.
  itemRef      String
  periodEnd    DateTime @db.Date
  /// Rank in the previous stored run of the same category, when the listing was in it.
  /// Null means the listing was not in the previous run, which the UI reports as new
  /// rather than as a rise from nowhere.
  previousRank Int?
  source       String

  createdAt DateTime @default(now())

  @@unique([marketplace, categorySlug, periodEnd, itemRef])
  @@index([categorySlug, periodEnd])
  @@index([periodEnd])
}

/// Where attention for one product sits geographically, as Google Trends reports it.
///
/// Written by jobs/geo.py. Three things about this table decide how it may be read, and all
/// three are properties of the source rather than choices:
///
///   1. A value is not a volume. Trends returns 0-100 normalised *within* the area asked
///      about, so 100 means "the busiest place in this list" and says nothing about how many
///      searches that was. Two products' values are not comparable with each other either.
///   2. A small population produces a large number cheaply. Measured on a real term:
///      Tonga scored 87 and St. Helena 75 against the Netherlands at 59, and Wyoming scored
///      100 against California at 24. That is the small-denominator problem the Reddit
///      counts already have, arriving through a different door.
///   3. City resolution does not exist here. Asked for directly, Trends returned an empty
///      frame for a term that has 51 US states of data, so the site says city demand is not
///      available from free sources instead of showing a metro table built from nothing.
model ProductRegion {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// country, or region for states and provinces inside one country.
  scope     String
  /// The area the breakdown was taken inside: empty for worldwide, otherwise a country
  /// code such as US or PK. Kept because a value only means anything relative to its list.
  geo       String
  /// Place name exactly as the source returned it, never translated or tidied.
  name      String
  /// 0-100 within this list. See the note above: not a volume, not cross-comparable.
  value     Float
  /// Position within this list, 1 being the highest value.
  rank      Int
  periodEnd DateTime @db.Date
  /// The window the breakdown covers, in the source's own words.
  timeframe String
  source    String
  createdAt DateTime @default(now())

  @@unique([productId, scope, geo, name, periodEnd])
  @@index([productId, periodEnd])
  @@index([scope, geo, periodEnd])
}

/// Direction of the headline wording counted for one target in one window.
///
/// This is tone counted from a fixed word list, not sentiment understood by a model. The
/// distinction is not pedantic: the list reads headlines only, it cannot see negation,
/// sarcasm or context, and it is stored as a count of matches so a reader can see the
/// arithmetic. Every surface that shows it has to say what produced it.
enum Tone {
  positive
  negative
  neutral
}

/// What the public discussion around one asset or product looked like in one window.
///
/// Written by jobs/human.py from News rows already stored, so it makes no request of its
/// own and can only describe coverage the site already holds. Three separate readings live
/// here and they are deliberately not combined into one score:
///
///   * tone, from a fixed word list over headlines
///   * attention, from how many items the window holds against the window before it
///   * a hype flag, which is attention rising at the same time as promotional wording
///
/// A target with too few items gets a row with the counts and no published direction,
/// because a tone computed on three headlines is three headlines.
model HumanSignal {
  id         String   @id @default(dbgenerated("gen_random_uuid()::text"))
  /// The asset or product this describes. Exactly one is set.
  assetId    String?
  asset      Asset?   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Whichever of the two ids above is set, copied so the unique key below can be a plain
  /// one. Postgres treats nulls as distinct in a unique index, so a key spanning two
  /// nullable columns would not actually stop a second row for the same target, and the
  /// alternative is the pair of partial indexes the News table needs. One non-null column
  /// is cheaper to read and cheaper to write an upsert against.
  targetRef  String
  periodEnd  DateTime @db.Date
  windowDays Int

  /// Headlines the word list was run over. The denominator for everything below it.
  items      Int
  positive   Int
  negative   Int
  neutral    Int
  /// none when items is below the floor in jobs/human.py.
  tone       Tone?
  /// (positive - negative) / items. Kept next to the counts, never shown without them.
  toneScore  Float?

  /// Items in the window of equal length immediately before this one.
  priorItems Int

  /// The catalyst side of the reading: not how much was published over a month, but whether
  /// something arrived in the last few days that was not arriving before. Attention rising
  /// over 30 days is a trend; four articles landing in three days against a baseline of one
  /// a week is an event, and the two need separating because only the second is the thing
  /// that moves a price before a reader has noticed it.
  recentItems   Int    @default(0)
  /// Items per day over the comparison window, which is the baseline the spike is measured
  /// against. Null when that window is too thin to average.
  baselineDaily Float?
  /// Recent items per day divided by baselineDaily. Null when there is no baseline.
  spikeRatio    Float?
  /// Set when spikeRatio clears its threshold on a baseline solid enough to divide by.
  catalyst      Boolean @default(false)
  catalystNote  String?
  /// Change in item count against that window. Null when the prior window was too thin to
  /// divide by, which is a missing measurement and never a zero.
  velocityPct Float?
  /// rising, flat, falling, or unknown when velocityPct could not be computed.
  attention   String

  /// Headlines containing promotional wording, and their share of the window.
  hypeTerms  Int
  hypeShare  Float?
  /// Attention rising and promotional wording above its threshold at the same time. The
  /// flag describes the coverage, not the asset: heavily promoted is not the same as
  /// overvalued, and the note says so.
  hypeFlag   Boolean  @default(false)
  hypeNote   String?

  confidence     Confidence @default(none)
  confidenceNote String?
  /// The feeds the items came from, so the reading can be traced back.
  source     String
  computedAt DateTime   @default(now())

  // The catalyst lookup is a partial index on periodEnd where catalyst is true, which
  // Prisma cannot express, so it lives in the migration alongside the columns. Declaring a
  // plain index here instead would put the false rows in it, which is nearly the whole
  // table, and would also drift from what the database actually has.
  @@unique([targetRef, periodEnd, windowDays])
  @@index([assetId, periodEnd])
  @@index([productId, periodEnd])
}

/// One observational reading, recorded on the day it was generated, so that what followed
/// can be measured against it later.
///
/// This is the part that stops the site being static. A reading is written here with the
/// factors it rested on, and jobs/accuracy.py comes back at 30 and 60 days and stores the
/// move that actually happened. Nothing in this table is a prediction and the stored move
/// is not a score of one: it is the record needed before any claim about how well these
/// readings have held up can be made honestly at all.
///
/// A row is only measurable when there is a close to measure. Product readings are logged
/// with no price attached and stay unmeasured until a product has a price series, which is
/// stated rather than filled in.
model SignalLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  /// humanSignal or demand today. One string rather than an enum because a new kind of
  /// reading should not need a migration to start being recorded.
  kind      String
  assetId   String?
  asset     Asset?   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// As on HumanSignal, and for the same reason.
  targetRef String
  issuedOn  DateTime @db.Date

  /// The reading in the words it was published in, so the log cannot drift from the page.
  claim     String
  /// The factors it rested on, written as a short readable list rather than a blob, so the
  /// log can be read by a person without a decoder.
  factors   String
  confidence Confidence @default(none)

  /// The close the later moves are measured from, and the day it is dated to. Null for a
  /// target with no price series.
  baseDate  DateTime? @db.Date
  baseClose Float?

  /// Measured, not projected. Null until the day arrives and a close exists.
  move30Pct    Float?
  measured30On DateTime? @db.Date
  move60Pct    Float?
  measured60On DateTime? @db.Date
  /// open, measured30, measured60, or unmeasurable when there is no price series.
  status    String   @default("open")

  createdAt DateTime @default(now())

  @@unique([kind, targetRef, issuedOn])
  @@index([status, issuedOn])
  @@index([assetId, issuedOn])
  @@index([productId, issuedOn])
}
