// NextBigThing schema. Every column here is read by the app or written by a data job.

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AssetType {
  stock
  etf
  crypto
  commodity
  /// A currency pair. It has no issuer, so `capBasis` is always `none` and no size figure is
  /// ever stored: there is nothing to multiply a price by. Returns and relative strength are
  /// the only rankings that mean anything here, which is why the size tables on an FX industry
  /// page are empty rather than zero.
  forex
}

/// marketCap = company market cap (price x shares).
/// fundAssets = ETF/fund size (price x shares outstanding).
/// none = not applicable, so no size figure is stored or shown.
enum CapBasis {
  marketCap
  fundAssets
  none
}

/// How much weight the stored numbers can carry, decided by rule in jobs/confidence.py
/// from how many sources agreed, how many peers the figure was measured against, and
/// whether any required input was missing. It is a description of the evidence, never a
/// prediction.
enum Confidence {
  high
  medium
  low
  none
}

enum SignalSource {
  googleTrends
  wikipedia
  reddit
  hackerNews
  googleNews
  market
}

model Industry {
  id       String @id @default(dbgenerated("gen_random_uuid()::text"))
  slug     String @unique
  name     String
  summary  String
  sort     Int    @default(0)
  /// Which exchange group this industry belongs to: US, PK, or Global. Ranking only ever
  /// happens inside one industry, so this never mixes currencies in a comparison. It is
  /// what lets the site show the Pakistani sectors as their own list with their own
  /// currency label.
  market   String @default("US")
  /// ISO code of the currency every size figure in this industry is quoted in.
  currency String @default("USD")

  assets   Asset[]
  rankings Ranking[]
  analysis Analysis[]
  news     News[]

  createdAt DateTime @default(now())
}

model Asset {
  id          String    @id @default(dbgenerated("gen_random_uuid()::text"))
  industryId  String
  industry    Industry  @relation(fields: [industryId], references: [id], onDelete: Cascade)
  symbol      String
  name        String
  assetType   AssetType
  capBasis    CapBasis  @default(marketCap)
  source      String
  sourceRef   String
  description String?
  /// Text written once per asset by a human. Facts only, no forecasts.
  note        String?
  /// ISO code of the currency close and marketCap are quoted in. Returns are percentages
  /// so they compare across currencies; a size figure does not, and is labelled.
  currency    String    @default("USD")

  snapshots        PriceSnapshot[]
  rankings         Ranking[]
  analysis         Analysis[]
  news             News[]
  productLinks     ProductAssetLink[]
  eventImpacts     EventImpact[]
  humanSignals     HumanSignal[]
  signalLogs       SignalLog[]
  analogs          AssetAnalog[]
  eventLinks       EventLink[]
  setups           AssetSetup[]
  eventStates      EventState[]
  theses           AssetThesis[]
  attributions     MoveAttribution[]
  relevance        GraphRelevance[]
  intraday         IntradayBar[]
  intradaySessions IntradaySession[]
  investigations   Investigation[]
  factors          AssetFactor[]
  decisions        DecisionLog[]

  createdAt DateTime @default(now())

  @@unique([industryId, symbol])
  @@index([symbol])
}

model PriceSnapshot {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  /// Both sources published these from the start and the job discarded them, which quietly
  /// put the day's range out of reach: with only a close, "where did it finish inside the
  /// day" and "how wide was the day" cannot be asked at all. Nullable because a row written
  /// before this column existed keeps its blank rather than being back-filled with the close,
  /// which would read as a day that never moved.
  open      Float?
  high      Float?
  low       Float?
  close     Float
  volume    Float?
  marketCap Float?
  source    String

  @@unique([assetId, date])
  @@index([date])
}

/// What measurably followed the past days that most resembled this asset's latest day.
///
/// Written by jobs/analogs.py from stored closes and volumes. The point is narrow and worth
/// stating exactly: it reports what happened after similar past days, and similarity here
/// means similar on the handful of factors the database actually holds. It is not a claim
/// that those factors caused anything, and it is not a forecast — the same setup appears in
/// the sample with both outcomes, which is why the spread and the count are stored next to
/// the average rather than under it.
model AssetAnalog {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// The day the setup was read from.
  periodEnd   DateTime @db.Date
  /// How many trading days forward the outcome is measured. 1 and 5 today.
  horizonDays Int

  /// The setup being matched, kept so a reader can see what "similar" meant here.
  dayReturnPct  Float
  volumeRatio   Float?
  fiveDayPct    Float?
  /// The tolerances the match used, in the same units, so the window is auditable.
  toleranceNote String

  /// How many past days matched, and what followed them.
  matches   Int
  positive  Int
  meanPct   Float?
  medianPct Float?
  /// The quartiles. A median on its own hides whether the matched days agreed: +1.2% median
  /// from a set running -1% to +3% is a different fact from the same median on a set running
  /// -18% to +22%, and only the second is a reason to stay out. Nullable because a set below
  /// the grading floor is not worth quartiles.
  p25Pct    Float?
  p75Pct    Float?
  minPct    Float?
  maxPct    Float?

  confidence     Confidence @default(none)
  confidenceNote String?
  source         String
  computedAt     DateTime   @default(now())

  matches_ AnalogMatch[]

  @@unique([assetId, periodEnd, horizonDays])
  @@index([assetId, periodEnd])
}

enum RankingBasis {
  /// Size at a past date.
  size
  /// Size today.
  sizeNow
  /// Total return between two dates.
  totalReturn
  /// Relative strength over 12 to 24 months, cross-checked against volume trend.
  rising
}

model Ranking {
  id             String       @id @default(dbgenerated("gen_random_uuid()::text"))
  industryId     String
  industry       Industry     @relation(fields: [industryId], references: [id], onDelete: Cascade)
  assetId        String
  asset          Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  basis          RankingBasis
  periodStart    DateTime?    @db.Date
  periodEnd      DateTime     @db.Date
  rank           Int
  sizeRank       Int?
  value          Float
  /// Rule-based evidence grade for this row. See jobs/confidence.py.
  confidence     Confidence   @default(none)
  /// Why the confidence is what it is, in one clause. Shown to the reader.
  confidenceNote String?
  source         String
  note           String?

  @@unique([industryId, basis, periodEnd, assetId])
  @@index([periodEnd])
}

enum AnalysisKind {
  /// One line on what moved between the pre-AI and post-AI snapshots.
  industryShift
  /// Why an asset is where it is now.
  assetPosition
  /// Why an asset is rising.
  assetRising
  /// What current data says may matter next. No prediction certainty.
  forwardLook
  /// Demand read on a product.
  productDemand
  /// Headline for the front page.
  siteLead
  /// What the largest measured moves were in the window after a dated event. The line
  /// reports the moves and never says the event caused them.
  eventImpact
}

model Analysis {
  id         String       @id @default(dbgenerated("gen_random_uuid()::text"))
  kind       AnalysisKind
  industryId String?
  industry   Industry?    @relation(fields: [industryId], references: [id], onDelete: Cascade)
  assetId    String?
  asset      Asset?       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  eventId    String?
  event      Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  headline   String
  body       String
  /// What is missing, and what would fill it.
  dataNote   String?
  /// Evidence grade carried from the numbers this line was built from.
  confidence Confidence   @default(none)
  source     String
  createdAt  DateTime     @default(now())

  @@index([kind])
  @@index([industryId])
  @@index([assetId])
  @@index([productId])
  @@index([eventId])
}

model News {
  id          String    @id @default(dbgenerated("gen_random_uuid()::text"))
  industryId  String?
  industry    Industry? @relation(fields: [industryId], references: [id], onDelete: Cascade)
  assetId     String?
  asset       Asset?    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title       String
  url         String
  publisher   String
  publishedAt DateTime
  source      String
  createdAt   DateTime  @default(now())

  /// Which story this item belongs to, assigned by jobs/lineage.py.
  ///
  /// One report syndicated to twenty outlets is one piece of information, and counting it as
  /// twenty is the difference between a catalyst and a wire pickup. Deduping by url cannot
  /// see this: twenty outlets means twenty urls, all genuinely distinct. So items are
  /// clustered by what they say, and every count that is meant to measure *information*
  /// counts lineages rather than rows.
  lineageId  String?
  /// True for the earliest item in its lineage, which is the closest thing the stored data
  /// has to an original report. It is a claim about order of publication, not authorship.
  isOriginal Boolean @default(false)

  // Deduping is per target, not global: the same article can be stored once per asset,
  // once per product, and once for an industry. Prisma cannot express the partial unique
  // indexes that does, so they live in the migration and inserts name them in ON CONFLICT.
  @@index([publishedAt])
  @@index([assetId])
  @@index([productId])
  @@index([lineageId])
}

/// One story, as distinct from the items that carry it.
///
/// Built by jobs/lineage.py by clustering stored headlines, deterministically and with no
/// model involved: titles are normalised to token shingles and two items join the same
/// lineage when their overlap clears a stated threshold inside a stated time window. The rule
/// is in the job and the threshold is stored on the row, so any cluster can be rechecked.
model NewsLineage {
  id         String   @id @default(dbgenerated("gen_random_uuid()::text"))
  /// The target the clustering was done within. Stories are clustered per asset or product,
  /// because the same wording about two different companies is two different stories.
  targetRef  String
  /// Earliest and latest publication time in the cluster.
  firstSeen  DateTime
  lastSeen   DateTime
  /// Items in the cluster, and how many distinct publishers carried it. The second number is
  /// the one that says whether a story travelled; the first says how many copies exist.
  items      Int
  publishers Int
  /// The earliest item's title, kept as the cluster's label. Not a summary of the cluster.
  headline   String
  /// The Jaccard threshold and window this cluster was built with, so it is auditable.
  rule       String
  computedAt DateTime @default(now())

  @@index([targetRef, lastSeen])
}

model Product {
  id              String     @id @default(dbgenerated("gen_random_uuid()::text"))
  slug            String     @unique
  name            String
  category        String
  summary         String
  /// Wikipedia article title used for the pageview signal.
  wikiTitle       String
  /// Google Trends term. Empty means no Trends data for this product.
  trendsTerm      String
  /// Subreddits searched through the public RSS endpoint. Comma separated.
  subreddits      String
  relatedTickers  String
  /// rising, early, flat, or unknown when there is not enough data.
  status          String     @default("unknown")
  demandScore     Float?
  demandNote      String?
  /// Rule-based grade of the demand read. See jobs/confidence.py.
  confidence      Confidence @default(none)
  /// Number of the 5 possible demand sources that returned a usable value.
  sourcesAnswered Int        @default(0)
  /// How many of those sources pointed the same way as the average.
  sourcesAgree    Int        @default(0)
  /// One clause on what the grade is based on.
  confidenceNote  String?
  computedAt      DateTime?

  signals      ProductSignal[]
  assetLinks   ProductAssetLink[]
  analysis     Analysis[]
  news         News[]
  humanSignals HumanSignal[]
  signalLogs   SignalLog[]
  regions      ProductRegion[]
  eventLinks   EventLink[]

  createdAt DateTime @default(now())
}

model ProductSignal {
  id        String       @id @default(dbgenerated("gen_random_uuid()::text"))
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  source    SignalSource
  /// Name of the number, for example "reddit_posts_30d" or "wiki_views_wow".
  metric    String
  value     Float?
  /// Evidence link or quoted text. Null when the source has no single item.
  evidence  String?
  periodEnd DateTime     @db.Date
  note      String?
  createdAt DateTime     @default(now())

  @@unique([productId, source, metric, periodEnd])
  @@index([productId, periodEnd])
}

model ProductAssetLink {
  id        String  @id @default(dbgenerated("gen_random_uuid()::text"))
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// Why these are related. Factual description of the relationship only.
  relation  String
  note      String?

  @@unique([productId, assetId])
}

/// A dated, publicly recorded event, seeded by hand from the public record.
///
/// The site measures what the market did in the window after the date. It never says the
/// event caused the move. Two things happening in the same fortnight is a sequence, not a
/// cause, and the only honest claim available from a price series is the size of the move.
model Event {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  slug      String   @unique
  name      String
  /// One or two factual sentences. What happened and when, nothing about what it meant.
  summary   String
  /// The day the event is dated to in the public record.
  date      DateTime @db.Date
  /// conflict, policy, technology, or market.
  category  String
  /// Where the date and the description come from, so a reader can check both.
  source    String
  sourceUrl String
  sort      Int      @default(0)

  /// Anything a reader would have to know to read the date correctly: that a time is not
  /// published, that the source calls it estimated, that it has moved once already.
  notes     String?
  /// True when the source publishes this as a scheduled or expected date rather than a date
  /// that has happened. Kept as a column rather than inferred from date > today, because a
  /// scheduled item does not become a historical fact the moment its day passes — it becomes
  /// a scheduled item whose day has passed, and the two read differently.
  scheduled Boolean @default(false)

  /// Where this event is in its life, advanced by jobs/lifecycle.py:
  ///
  ///   discovered  a source published the date; nothing checked yet
  ///   upcoming    the date is confirmed present and more than APPROACHING_DAYS away
  ///   approaching inside that window, so it is worth showing prominently
  ///   live        the date is today
  ///   resolved    the date has passed and the move after it has been measured
  ///   historical  resolved, and old enough that it is evidence rather than news
  ///
  /// A state and not a derived expression, because the transition to `resolved` is the moment
  /// the pre-event state is frozen, and that has to happen exactly once.
  lifecycle    String    @default("discovered")
  /// When the system first saw this date. Distinct from the event date and from createdAt,
  /// because how long a date was known is itself evidence: a report scheduled three months
  /// out is different from one announced yesterday.
  discoveredAt DateTime  @default(now())
  /// Set when lifecycle became resolved, so the freeze cannot silently re-run.
  resolvedAt   DateTime?

  impacts  EventImpact[]
  analysis Analysis[]
  links    EventLink[]
  states   EventState[]

  createdAt DateTime @default(now())

  @@index([date])
  @@index([scheduled, date])
}

/// What was true about an asset immediately before an event, and what was true after it.
///
/// This table exists to make look-ahead bias structurally impossible rather than a rule
/// somebody has to remember. The problem it solves: once an event has passed, every table in
/// this database holds the post-event world, so asking "what did we know before the earnings
/// report" by querying current data silently answers with information that did not exist
/// then. Freezing the before-state at the moment of resolution is the only way to ask the
/// question honestly later.
///
/// `phase` is `before` or `after`. The before row is written once, when the event resolves,
/// from observations dated strictly earlier than the event. The after row is written when the
/// measurement window has elapsed. Neither is ever rewritten — a correction becomes a new
/// row with a later computedAt, so the record of what the system believed at the time
/// survives its own revisions.
model EventState {
  id      String   @id @default(dbgenerated("gen_random_uuid()::text"))
  eventId String
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assetId String
  asset   Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// before or after.
  phase   String
  /// The observation date the values come from, which is never the event date itself for a
  /// before row: it is the last trading day strictly before it.
  asOf    DateTime @db.Date

  close       Float?
  volume      Float?
  /// Volume as a multiple of its own trailing average on that date.
  volumeRatio Float?
  /// Return over the 20 sessions ending at asOf.
  trailingPct Float?
  /// The news reading that existed then: tone, story count, whether a catalyst was flagged.
  tone        String?
  stories     Int?
  catalyst    Boolean?
  /// What the system's own condition read said at the time, if it had one.
  setupState  String?

  /// Only on an after row: the measured change from the before row's close.
  changePct  Float?
  windowDays Int?

  source     String
  computedAt DateTime @default(now())

  @@unique([eventId, assetId, phase])
  @@index([assetId, asOf])
}

/// What an event is about, for events that have not happened yet.
///
/// EventImpact already ties an event to an asset, but only by measuring a move after it, so
/// it cannot exist before the event does. This is the forward half: the reason an upcoming
/// date is worth showing next to an asset at all. Separate table rather than a column on
/// Event because one date routinely concerns several assets, and a policy date concerns a
/// whole sector.
model EventLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assetId   String?
  asset     Asset?   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Why this event is attached to this target, in plain words. Factual and stated, never
  /// a claim that the event will move it.
  relation  String
  /// As on HumanSignal: whichever id is set, copied so the unique key can be a plain one.
  targetRef String

  @@unique([eventId, targetRef])
  @@index([assetId])
  @@index([productId])
}

/// One asset's measured price move over a window that starts at an event's date.
///
/// Written by jobs/events.py from rows already in PriceSnapshot, so an event window that
/// falls outside the stored history produces no rows rather than an estimate.
model EventImpact {
  id              String     @id @default(dbgenerated("gen_random_uuid()::text"))
  eventId         String
  event           Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assetId         String
  asset           Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// Length of the measured window in calendar days. 30 unless stated otherwise.
  windowDays      Int
  /// The two stored closes the change is computed from, kept so the figure can be checked.
  startDate       DateTime   @db.Date
  startClose      Float
  endDate         DateTime   @db.Date
  endClose        Float
  changePct       Float
  /// Change in 20 day average volume across the same window. Null when the source
  /// published no volume for this asset.
  volumeChangePct Float?
  /// Position within the event, 1 being the largest move by absolute size.
  rank            Int
  confidence      Confidence @default(none)
  confidenceNote  String?
  source          String

  @@unique([eventId, assetId, windowDays])
  @@index([eventId, rank])
}

/// One row of a public marketplace ranking, as published on the page on the day it was read.
///
/// This is deliberately not a ProductSignal. Attention and marketplace position are
/// different claims: a search trend says people are looking, a bestseller rank says a
/// listing is selling relative to others in its category. Mixing them into one average
/// would hide which of the two a number came from, so marketplace rows are stored apart
/// and never enter the demand score.
model MarketplaceItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()::text"))
  /// Only amazonBestSellers today. eBay is not stored: see brain.md for the verdict.
  marketplace  String
  categorySlug String
  categoryName String
  rank         Int
  title        String
  url          String
  /// Marketplace item id, Amazon's ASIN today. Used to follow one listing between runs.
  itemRef      String
  periodEnd    DateTime @db.Date
  /// Rank in the previous stored run of the same category, when the listing was in it.
  /// Null means the listing was not in the previous run, which the UI reports as new
  /// rather than as a rise from nowhere.
  previousRank Int?
  source       String

  createdAt DateTime @default(now())

  @@unique([marketplace, categorySlug, periodEnd, itemRef])
  @@index([categorySlug, periodEnd])
  @@index([periodEnd])
}

/// Where attention for one product sits geographically, as Google Trends reports it.
///
/// Written by jobs/geo.py. Three things about this table decide how it may be read, and all
/// three are properties of the source rather than choices:
///
///   1. A value is not a volume. Trends returns 0-100 normalised *within* the area asked
///      about, so 100 means "the busiest place in this list" and says nothing about how many
///      searches that was. Two products' values are not comparable with each other either.
///   2. A small population produces a large number cheaply. Measured on a real term:
///      Tonga scored 87 and St. Helena 75 against the Netherlands at 59, and Wyoming scored
///      100 against California at 24. That is the small-denominator problem the Reddit
///      counts already have, arriving through a different door.
///   3. City resolution does not exist here. Asked for directly, Trends returned an empty
///      frame for a term that has 51 US states of data, so the site says city demand is not
///      available from free sources instead of showing a metro table built from nothing.
model ProductRegion {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// country, or region for states and provinces inside one country.
  scope     String
  /// The area the breakdown was taken inside: empty for worldwide, otherwise a country
  /// code such as US or PK. Kept because a value only means anything relative to its list.
  geo       String
  /// Place name exactly as the source returned it, never translated or tidied.
  name      String
  /// 0-100 within this list. See the note above: not a volume, not cross-comparable.
  value     Float
  /// Position within this list, 1 being the highest value.
  rank      Int
  periodEnd DateTime @db.Date
  /// The window the breakdown covers, in the source's own words.
  timeframe String
  source    String
  createdAt DateTime @default(now())

  @@unique([productId, scope, geo, name, periodEnd])
  @@index([productId, periodEnd])
  @@index([scope, geo, periodEnd])
}

/// The measured conditions around one asset, and whether they currently add up to a setup
/// the stored rules recognise.
///
/// Three things about this table are load-bearing and none of them is decoration:
///
///  1. The state is produced by explicit rules over stored numbers. There is no model and no
///     judgement in it. Every condition that was tested is written to `conditions`, including
///     the ones that failed, so the state can be rederived by hand from the row.
///  2. `missing` lists the inputs that were not available. A rule that could not be evaluated
///     is reported as unevaluated, never as satisfied — the difference is the whole reason a
///     reader can trust the other fields.
///  3. Entry and invalidation are levels computed from stored prices, not targets. The
///     invalidation is the one that matters: it is the measurable condition under which the
///     reason for the state has stopped being true.
///
/// It describes conditions. It is not advice, it does not say what will happen, and the
/// reader decides. The site says so next to every one of these.
model AssetSetup {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  periodEnd DateTime @db.Date
  /// intraday, swing or longer. The same asset can read differently on each, which is not a
  /// contradiction: different horizons are computed from different windows.
  horizon   String

  /// buy, short, wait or none, decided by the rules in jobs/setup.py.
  state      String
  /// One plain sentence naming the conditions that produced the state.
  headline   String
  /// Every condition tested, as "name=value (pass|fail)", so the state is rederivable.
  conditions String
  /// Inputs that could not be evaluated, named. Empty when all were available.
  missing    String
  /// Conditions pointing the other way, kept because hiding them is what makes a clean
  /// signal out of mixed data.
  against    String

  /// Levels computed from stored closes, with the window they came from stated.
  entryLevel      Float?
  entryNote       String?
  invalidateLevel Float?
  invalidateNote  String?
  /// A measured range from the historical analogs, never a projection.
  rangeNote       String?

  confidence     Confidence @default(none)
  confidenceNote String?
  source         String
  computedAt     DateTime   @default(now())

  targets SetupTarget[]

  @@unique([assetId, periodEnd, horizon])
  @@index([state, periodEnd])
}

/// How reliable a source has turned out to be, learned rather than declared.
///
/// A Beta posterior over a single rate: alpha and beta are the prior, successes and
/// observations accumulate from measured outcomes, and the expected reliability is
/// (alpha + successes) / (alpha + beta + observations). The point of the prior is that a
/// source with two observations does not get to look perfect; it starts near the middle and
/// earns its way out.
///
/// No source is hard-coded as trustworthy. What "success" means is stored on the row,
/// because reliability is only meaningful against a stated question.
model SourceReliability {
  id           String   @id @default(dbgenerated("gen_random_uuid()::text"))
  source       String
  /// The question the rate is about, e.g. the horizon a signal from this source was
  /// measured over. Reliability is segmented, never global.
  eventClass   String
  alpha        Float    @default(2)
  beta         Float    @default(2)
  observations Int      @default(0)
  successes    Int      @default(0)
  /// (alpha + successes) / (alpha + beta + observations), stored so the page need not
  /// recompute it and so the value at a point in time is recoverable.
  expected     Float?
  /// What counted as a success here, in words.
  criterion    String
  updatedAt    DateTime @default(now())

  @@unique([source, eventClass])
}

/// What the system cannot currently see, measured rather than assumed.
///
/// A site that quietly stops receiving a feed looks identical to a quiet week, and the second
/// is a finding while the first is a fault. So the gap between how often a source should
/// produce something and how long it has actually been silent is measured, and turned into a
/// risk of missing something:
///
///     gapRatio = actualGap / expectedInterval
///     missRisk = 1 - exp(-criticality * gapRatio)
///
/// The states are deliberately not a single percentage. "Unobserved" and "unknown" are
/// different claims, and a completeness score folds them together.
model Coverage {
  id                    String    @id @default(dbgenerated("gen_random_uuid()::text"))
  source                String
  /// How often this source is expected to yield something, in hours.
  expectedIntervalHours Float
  /// How long it has actually been, in hours, at computedAt.
  actualGapHours        Float
  gapRatio              Float
  /// How much a miss here would matter, 0 to 1. A judgement, stored next to the arithmetic
  /// rather than folded into it.
  criticality           Float
  missRisk              Float
  /// healthy, stale, or silent.
  status                String
  /// Rows the source has contributed, and the newest one's timestamp.
  rows                  Int
  newest                DateTime?
  note                  String?
  computedAt            DateTime  @default(now())

  @@unique([source, computedAt])
  @@index([status, computedAt])
}

/// Whether the system's own confidence grades deserve to be believed.
///
/// A grade is a claim about how often something holds. That claim is itself checkable, and
/// until it is checked a grade is decoration. Each row is one bucket: the grade that was
/// given, how many of those matured, and how often the thing actually went the way the
/// reading pointed. Brier and log loss are stored beside the rate because a rate alone
/// cannot distinguish a well separated forecaster from a lucky one.
///
/// Published only above a floor, in the job and again in the query layer.
model Calibration {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  /// The population the bucket was computed over, e.g. humanSignal readings at 5 days.
  population  String
  horizonDays Int
  /// The grade or probability band this bucket represents.
  bucket      String
  /// What the system implied would happen at this grade, as a rate between 0 and 1.
  predicted   Float
  /// What actually happened, as a rate over `n` matured rows.
  actual      Float?
  n           Int
  brier       Float?
  logLoss     Float?
  note        String?
  computedAt  DateTime @default(now())

  @@unique([population, horizonDays, bucket, computedAt])
  @@index([population, computedAt])
}

/// Direction of the headline wording counted for one target in one window.
///
/// This is tone counted from a fixed word list, not sentiment understood by a model. The
/// distinction is not pedantic: the list reads headlines only, it cannot see negation,
/// sarcasm or context, and it is stored as a count of matches so a reader can see the
/// arithmetic. Every surface that shows it has to say what produced it.
enum Tone {
  positive
  negative
  neutral
}

/// What the public discussion around one asset or product looked like in one window.
///
/// Written by jobs/human.py from News rows already stored, so it makes no request of its
/// own and can only describe coverage the site already holds. Three separate readings live
/// here and they are deliberately not combined into one score:
///
///   * tone, from a fixed word list over headlines
///   * attention, from how many items the window holds against the window before it
///   * a hype flag, which is attention rising at the same time as promotional wording
///
/// A target with too few items gets a row with the counts and no published direction,
/// because a tone computed on three headlines is three headlines.
model HumanSignal {
  id         String   @id @default(dbgenerated("gen_random_uuid()::text"))
  /// The asset or product this describes. Exactly one is set.
  assetId    String?
  asset      Asset?   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Whichever of the two ids above is set, copied so the unique key below can be a plain
  /// one. Postgres treats nulls as distinct in a unique index, so a key spanning two
  /// nullable columns would not actually stop a second row for the same target, and the
  /// alternative is the pair of partial indexes the News table needs. One non-null column
  /// is cheaper to read and cheaper to write an upsert against.
  targetRef  String
  periodEnd  DateTime @db.Date
  windowDays Int

  /// Headlines the word list was run over. The denominator for everything below it.
  items     Int
  positive  Int
  negative  Int
  neutral   Int
  /// none when items is below the floor in jobs/human.py.
  tone      Tone?
  /// (positive - negative) / items. Kept next to the counts, never shown without them.
  toneScore Float?

  /// Items in the window of equal length immediately before this one.
  priorItems Int

  /// The catalyst side of the reading: not how much was published over a month, but whether
  /// something arrived in the last few days that was not arriving before. Attention rising
  /// over 30 days is a trend; four articles landing in three days against a baseline of one
  /// a week is an event, and the two need separating because only the second is the thing
  /// that moves a price before a reader has noticed it.
  recentItems   Int     @default(0)
  /// Items per day over the comparison window, which is the baseline the spike is measured
  /// against. Null when that window is too thin to average.
  baselineDaily Float?
  /// Recent items per day divided by baselineDaily. Null when there is no baseline.
  spikeRatio    Float?
  /// Set when spikeRatio clears its threshold on a baseline solid enough to divide by.
  catalyst      Boolean @default(false)
  catalystNote  String?

  /// Distinct stories rather than items, over the same recent window. This is the count the
  /// catalyst decision is actually made on: a ratio built on copies measures syndication,
  /// and syndication is a fact about the news industry rather than about the asset.
  recentStories      Int    @default(0)
  /// The same for the baseline window, as stories per day.
  baselineStoryDaily Float?
  /// Robust standardised deviation of the recent story rate against the baseline window's
  /// own daily history: (x - median) / (1.4826 * MAD). Used instead of a plain ratio because
  /// a ratio against a mean is dragged around by the one busy day inside the baseline, which
  /// is exactly the kind of day a news feed produces.
  robustZ            Float?
  /// spike when the recent window alone is elevated, persistent when the elevation has held
  /// across the window, none when neither. A single loud day and a fortnight of steadily
  /// heavier coverage are different events and only the second changes a baseline.
  changeKind         String @default("none")
  /// Change in item count against that window. Null when the prior window was too thin to
  /// divide by, which is a missing measurement and never a zero.
  velocityPct        Float?
  /// rising, flat, falling, or unknown when velocityPct could not be computed.
  attention          String

  /// Headlines containing promotional wording, and their share of the window.
  hypeTerms Int
  hypeShare Float?
  /// Attention rising and promotional wording above its threshold at the same time. The
  /// flag describes the coverage, not the asset: heavily promoted is not the same as
  /// overvalued, and the note says so.
  hypeFlag  Boolean @default(false)
  hypeNote  String?

  confidence     Confidence @default(none)
  confidenceNote String?
  /// The feeds the items came from, so the reading can be traced back.
  source         String
  computedAt     DateTime   @default(now())

  // The catalyst lookup is a partial index on periodEnd where catalyst is true, which
  // Prisma cannot express, so it lives in the migration alongside the columns. Declaring a
  // plain index here instead would put the false rows in it, which is nearly the whole
  // table, and would also drift from what the database actually has.
  @@unique([targetRef, periodEnd, windowDays])
  @@index([assetId, periodEnd])
  @@index([productId, periodEnd])
}

/// One observational reading, recorded on the day it was generated, so that what followed
/// can be measured against it later.
///
/// This is the part that stops the site being static. A reading is written here with the
/// factors it rested on, and jobs/accuracy.py comes back at 30 and 60 days and stores the
/// move that actually happened. Nothing in this table is a prediction and the stored move
/// is not a score of one: it is the record needed before any claim about how well these
/// readings have held up can be made honestly at all.
///
/// A row is only measurable when there is a close to measure. Product readings are logged
/// with no price attached and stay unmeasured until a product has a price series, which is
/// stated rather than filled in.
model SignalLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  /// humanSignal or demand today. One string rather than an enum because a new kind of
  /// reading should not need a migration to start being recorded.
  kind      String
  assetId   String?
  asset     Asset?   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// As on HumanSignal, and for the same reason.
  targetRef String
  issuedOn  DateTime @db.Date

  /// The reading in the words it was published in, so the log cannot drift from the page.
  claim      String
  /// The factors it rested on, written as a short readable list rather than a blob, so the
  /// log can be read by a person without a decoder.
  factors    String
  confidence Confidence @default(none)

  /// The close the later moves are measured from, and the day it is dated to. Null for a
  /// target with no price series.
  baseDate  DateTime? @db.Date
  baseClose Float?

  /// Measured, not projected. Null until the day arrives and a close exists.
  ///
  /// Four horizons rather than two: a catalyst is a short-horizon thing by nature, and
  /// measuring it only at 30 days would answer a question nobody asked about it. The 1 and 5
  /// day marks are where an arriving story either mattered or did not.
  move1Pct     Float?
  measured1On  DateTime? @db.Date
  move5Pct     Float?
  measured5On  DateTime? @db.Date
  move30Pct    Float?
  measured30On DateTime? @db.Date
  move60Pct    Float?
  measured60On DateTime? @db.Date
  /// open, measured1, measured5, measured30, measured60, or unmeasurable when there is no
  /// price series. Always the furthest horizon reached.
  status       String    @default("open")

  createdAt DateTime @default(now())

  @@unique([kind, targetRef, issuedOn])
  @@index([status, issuedOn])
  @@index([assetId, issuedOn])
  @@index([productId, issuedOn])
}

/// A reason, remembered from the day it was recorded.
///
/// `AssetSetup` is honest about today and silent about yesterday: a `buy` read written two
/// weeks ago on conditions that have since reversed looked identical to one written this
/// morning. A thesis is a run — the stretch of consecutive reads on which one directional
/// state was held — and every later day is measured against the row from the run's first day
/// rather than against the day before.
///
/// The opening conditions are copied onto this row rather than re-derived, which is the whole
/// point. Recomputing them from today's data would answer "what would we have said then,
/// knowing what we know now", which is the one question a frozen reason exists to prevent.
///
/// Written by jobs/thesis.py.
model AssetThesis {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  horizon   String
  /// buy or short. Only directional states become theses: `wait` and `none` hold no reason
  /// that could later stop being true.
  direction String
  /// The first day of the run, which is the day the reason was recorded.
  openedOn  DateTime @db.Date

  /// The sentence and the full condition string from that day, copied verbatim.
  openHeadline    String
  openConditions  String
  openClose       Float?
  /// The level that day named as the point at which the trend being read is no longer there,
  /// and the entry level beside it. Both from the opening row, never recomputed.
  invalidateLevel Float?
  entryLevel      Float?

  /// active, weakening or broken. Broken is terminal and is never reassessed, so a later
  /// recovery cannot quietly erase the fact that the level named in advance was passed.
  status  String
  /// Why it has that status, in plain words.
  reason  String
  /// Condition names whose verdict differs from the opening day's, and those that match. A
  /// condition that has become unavailable counts as changed, never as held.
  changed String
  held    String

  /// The read this assessment was made against.
  asOf               DateTime @db.Date
  lastClose          Float?
  changePctSinceOpen Float?
  /// Stored sessions since the opening day. Sessions, not calendar days, because a weekend is
  /// not a day on which nothing happened to the conditions.
  sessionsSince      Int      @default(0)

  confidence     Confidence @default(none)
  /// How much of the opening reason is still measurable. Never how the price has gone:
  /// grading a thesis on its return would turn a statement about evidence into a scorecard.
  confidenceNote String?
  source         String
  computedAt     DateTime   @default(now())

  checks ThesisCheck[]

  @@unique([assetId, horizon, openedOn])
  @@index([status, asOf])
}

/// One day's assessment of one thesis, frozen.
///
/// Separate from AssetThesis because the thesis row is updated and this one is not. A check is
/// never rewritten, so the record of what the system believed on a Tuesday survives Wednesday
/// disagreeing with it, and the sequence of rows is the history of a reason decaying rather
/// than a single status that only ever shows its last value.
model ThesisCheck {
  id       String      @id @default(dbgenerated("gen_random_uuid()::text"))
  thesisId String
  thesis   AssetThesis @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  asOf     DateTime    @db.Date

  status             String
  reason             String
  changed            String
  held               String
  close              Float?
  changePctSinceOpen Float?

  source     String
  computedAt DateTime @default(now())

  @@unique([thesisId, asOf])
  @@index([asOf])
}

/// Three competing accounts of one move, measured rather than asserted.
///
///     total = market + sector + specific
///
/// where `market` is the median return across the asset's exchange group, `sector` is the
/// median across its own industry peers minus that market median, and `specific` is the
/// asset's return minus its peer median. Medians rather than means, because one 400% crypto
/// return would otherwise describe a sector nobody is in.
///
/// This is co-movement and is reported as exactly that. The leading component is the one the
/// move is most *shared with*, which is a different sentence from one about cause, and no
/// probability is attached to any of the three: a likelihood ratio needs a measured P(E|H)
/// and no outcome row in this database has matured.
///
/// sectorPct and specificPct are null together when fewer than three industry peers have the
/// history to take a median from. The remainder is left unsplit rather than credited to the
/// asset, because crediting it would read as a finding about the asset when all it measures is
/// that its industry is thinly covered here.
///
/// Written by jobs/attribution.py.
model MoveAttribution {
  id         String   @id @default(dbgenerated("gen_random_uuid()::text"))
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  periodEnd  DateTime @db.Date
  /// Sessions the move is measured over, so a row is never read against the wrong window.
  windowDays Int

  totalPct    Float
  marketPct   Float
  sectorPct   Float?
  specificPct Float?

  /// Each part's size as a share of the total movement accounted for, from absolute values so
  /// two parts cannot cancel into a share above one.
  marketShare   Float?
  sectorShare   Float?
  specificShare Float?

  /// market, sector or specific, and null when the top two are too close to separate or the
  /// sample does not support naming one.
  leader       String?
  /// How many times larger the leading component is than the next.
  leaderMargin Float?

  /// The counts the medians were taken from, stored because a share computed over three peers
  /// and one computed over thirty are not the same claim.
  peers     Int
  groupSize Int

  headline       String
  confidence     Confidence @default(none)
  confidenceNote String?
  /// How the three parts were obtained, in words.
  method         String
  source         String
  computedAt     DateTime   @default(now())

  @@unique([assetId, periodEnd, windowDays])
  @@index([periodEnd, leader])
}

/// A flagged catalyst carried a bounded distance across the relationships already stored.
///
/// What travels is relevance, which means a reason to look. It is not impact and not an
/// effect: an edge states a relationship somebody recorded, and it does not state that a move
/// on one end reaches the other.
///
/// Bounded three ways, because an unbounded walk over a 160 asset graph reaches everything and
/// tells nobody anything: two hops at most, edge groups above a size limit skipped entirely,
/// and every edge divided by the size of the group it came from so that being one of two
/// assets linked to a product counts for more than being one of twenty in a sector.
///
/// `path` stores the chain in words, so a reader can follow it and reject it. A score without
/// its path would be exactly the unsupported chain this project exists not to produce.
///
/// Written by jobs/graph.py.
model GraphRelevance {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  periodEnd DateTime @db.Date

  /// asset or product — what carried the catalyst this path started from.
  originKind String
  originId   String

  score    Float
  /// 1 or 2. Never more, by construction.
  hops     Int
  /// The kind of edge the last step used: industry, product or event.
  edgeKind String
  path     String
  note     String

  source     String
  computedAt DateTime @default(now())

  @@unique([assetId, periodEnd, originKind, originId])
  @@index([periodEnd, score])
}

/// One intraday bar, normalised, with the source and the interval it was actually fetched at.
///
/// Stored at a single canonical interval and derived upward rather than fetched per interval.
/// Five minutes is the canonical one: it is the finest the provider serves more than a week
/// of, 15m / 30m / 1h all divide into it exactly, and one 5m request covers a whole session
/// where a 1m request covers a fraction of it at twelve times the rows. A 1m bar is fetched
/// only for an asset that needs it, and when it is, it is stored here at `interval = 1`
/// alongside the 5m rows rather than replacing them.
///
/// `interval` is minutes, and it is part of the key rather than a column to filter later: a
/// 5m bar and a 15m bar covering the same minute are two different observations of it, and a
/// query that forgot to say which it wanted would silently mix them.
///
/// `derived` marks a bar this system computed by aggregating finer bars rather than one the
/// provider served. It is never inferred from the interval, because the provider can serve
/// 15m directly and that row is not derived. A derived bar is reproducible; a fetched one is
/// evidence, and §9 says evidence must stay recoverable.
///
/// No bar is ever invented. A session with a gap keeps the gap: `barsExpected` on
/// `IntradaySession` is what makes the gap visible instead of making the series look whole.
///
/// Written by jobs/intraday.py.
model IntradayBar {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// Bar interval in minutes: 5 is canonical, 1 is fetched only for the active set, and
  /// 15/30/60 are derived from 5 where every component bar is present.
  interval    Int
  /// Bar open time in UTC. The exchange's own timezone is on the session row, so a reader
  /// never has to guess which clock a timestamp is in.
  ts          DateTime
  /// The exchange session date this bar belongs to, in exchange-local terms. Stored rather
  /// than computed from `ts`, because a session that crosses midnight UTC would otherwise
  /// split in two.
  sessionDate DateTime @db.Date

  open   Float
  high   Float
  low    Float
  close  Float
  /// Null, not zero, when the provider served no volume for the bar. A zero-volume bar is a
  /// real thing on a quiet five minutes and must stay distinguishable from an absent one.
  volume Float?

  /// regular, pre or post. Kept because a pre-market breakout on 400 shares is not the same
  /// observation as the same move in the regular session, and averaging the two would hide it.
  phase String @default("regular")

  /// True when this bar was aggregated from finer stored bars rather than fetched.
  derived     Boolean @default(false)
  /// The interval it was derived from, when it was.
  derivedFrom Int?

  source      String
  retrievedAt DateTime @default(now())

  @@unique([assetId, interval, ts])
  @@index([assetId, interval, sessionDate])
  @@index([sessionDate])
}

/// What one fetch of one asset's intraday series actually returned.
///
/// This is the completeness record §8 asks for, and it is a separate table because the
/// interesting cases are the ones where there is no data to put in `IntradayBar`. A provider
/// that serves half a session looks identical to a quiet session once the bars are stored;
/// the only way to tell them apart is to have written down how many bars the session should
/// have had.
///
/// status is one of:
///   complete    every expected bar arrived
///   partial     some arrived, fewer than expected
///   empty       the provider answered, with no bars — a real answer for a closed market
///   stale       the newest bar is older than the interval should allow
///   failed      the provider did not answer, or answered unusably
///   unsupported this asset's class has no intraday source, which is a fact and not a failure
///
/// `unsupported` is the row that keeps the capability honest for assets the provider cannot
/// serve. The architecture holds; the coverage does not, and the page says which.
model IntradaySession {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sessionDate DateTime @db.Date
  interval    Int

  status       String
  /// How many bars a full session at this interval would hold, from the provider's own
  /// stated trading period rather than from a constant.
  barsExpected Int?
  barsStored   Int    @default(0)
  /// Bars the provider served with a null close, which are holes rather than observations.
  barsNull     Int    @default(0)

  /// The exchange timezone the session is defined in, as the provider stated it.
  exchangeTz String?
  firstTs    DateTime?
  lastTs     DateTime?

  /// Plain words: what arrived, what did not, and what that means for reading the bars.
  note        String
  source      String
  retrievedAt DateTime @default(now())

  @@unique([assetId, sessionDate, interval])
  @@index([status, sessionDate])
}

/// A target range, attached to the setup it was computed for.
///
/// Separate from AssetSetup because a target is the part of a setup most likely to be absent.
/// Making it a set of nullable columns on the setup row would put five holes in the middle of
/// a row that is otherwise always complete, and would make "no target" and "target not yet
/// computed" the same state.
///
/// A target here is a **measured range**, never a prediction. Every one is derived from one of
/// three stored things, and the row says which:
///
///   structure   the next level above or below where price recently turned, from stored bars
///   volatility  a multiple of the asset's own measured true range over the window
///   analog      the distribution of what actually followed similar past days
///
/// Where the methods disagree materially the disagreement is preserved rather than averaged:
/// `agreement` records how far apart they were, and the UI shows the spread. §31 — averaging
/// two methods that disagree into one number manufactures a certainty neither supports.
///
/// A target is only written when `rewardRisk` can also be computed, because a level with no
/// invalidation behind it is a number with no decision attached to it.
model SetupTarget {
  id      String     @id @default(dbgenerated("gen_random_uuid()::text"))
  setupId String
  setup   AssetSetup @relation(fields: [setupId], references: [id], onDelete: Cascade)

  /// structure, volatility or analog.
  method      String
  /// The range. Low and high are the same number only when the method produces a single
  /// level, which is stated in the note rather than implied.
  low         Float
  high        Float
  /// Distance from the entry to the near edge of the range, as a percentage.
  distancePct Float?
  /// Reward against risk, using the setup's own invalidation level as the risk. Null when no
  /// invalidation exists, in which case no target row is written at all.
  rewardRisk  Float?

  /// How far the methods were from each other, as a share of the widest range. Stored on each
  /// row so a reader looking at one method can see it was not the only one.
  agreement  Float?
  /// Plain words: what this range was measured from and what it is not.
  note       String
  source     String
  computedAt DateTime @default(now())

  @@unique([setupId, method])
}

/// What was actually looked at when something moved unusually, including what was not found.
///
/// The catalyst flag detects that news arrived. This is the other half: when an asset moves
/// materially, something goes looking at the evidence that could bear on it, and records the
/// search rather than only the conclusion.
///
/// The absences are the point. A large move with no story behind it is the common case, and a
/// system that prints nothing in that case has told the reader less than one that says "we
/// looked at company news, the sector, the calendar and the related names, and found a sector
/// move and no company story". `notFound` is therefore a stored field and not an empty state:
/// §23 forbids stopping when no headline is found, and forbids inventing one.
///
/// `pointsToward` is always phrased as what the move was *shared with* or *preceded by*, never
/// as what moved it. Two things happening in one afternoon is a sequence. The banned words from
/// brain.md rule 10 are banned here too and the test suite checks the generated text for them.
///
/// Targeted, not exhaustive: the investigation reads this asset, its own industry peers, its
/// bounded graph neighbourhood and its own calendar. It never scans the universe, which is what
/// keeps it affordable on this infrastructure.
///
/// Written by jobs/investigate.py.
model Investigation {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  periodEnd DateTime @db.Date

  /// Why this asset was investigated at all: move, volume, or catalyst. Stored because an
  /// investigation nobody can see the trigger for is a conclusion without a question.
  trigger       String
  triggerDetail String

  /// The measured change that triggered it, with the robust score it was judged unusual by.
  movePct     Float?
  robustZ     Float?
  volumeRatio Float?

  /// Plain language, one line each. These are what the page shows first.
  headline     String
  found        String
  notFound     String
  pointsToward String
  unconfirmed  String

  /// The hypothesis with the most measured support, or null when none leads.
  leading        String?
  confidence     Confidence @default(none)
  confidenceNote String?

  source     String
  computedAt DateTime @default(now())

  findings   InvestigationFinding[]
  hypotheses InvestigationHypothesis[]

  @@unique([assetId, periodEnd])
  @@index([periodEnd, trigger])
}

/// One thing the investigation checked, and what it found there — including nothing.
///
/// `status` separates the three answers that an absent row would collapse into one:
///   found       the evidence exists and is described
///   absent      it was checked and there is genuinely none
///   unavailable it could not be checked, which is not the same as there being none
///
/// That distinction is the whole value of the table. "No news" and "the news source did not
/// answer" look identical in a row count and mean opposite things.
model InvestigationFinding {
  id              String        @id @default(dbgenerated("gen_random_uuid()::text"))
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  /// What was checked: news, attribution, peers, volume, calendar, graph, analog, intraday
  /// or product.
  kind       String
  status     String
  /// Plain words, with the figure in them where there is one.
  detail     String
  /// Where the evidence came from, so a reader can check it.
  sourceName String?
  /// When the evidence itself is dated, which is not when it was looked at. A story published
  /// after the close cannot be evidence about that close, and only this field can show it.
  observedAt DateTime?

  @@unique([investigationId, kind])
}

/// A competing explanation, with its measured support kept separate from its prior.
///
/// Four hypotheses, and the honest division between them is which ones arithmetic can settle:
///
///   market    the move is what the whole exchange group did
///   sector    the move is what its own industry did beyond the group
///   specific  neither accounts for it, so it is particular to this asset
///   news      a dated story or event preceded the move
///
/// The first three are *measured directly* by jobs/attribution.py — they are exclusive by
/// construction and sum to the move — so no inference is needed and none is performed. The
/// fourth is the one that genuinely requires evidence, and it is also the one no arithmetic can
/// confirm: a story dated before a move is a sequence, not a cause.
///
/// `priorBase` is a real base rate measured from the stored population — how often each
/// component has actually led across every attribution row — and not a number chosen by hand.
/// `posterior` stays null, and `posteriorNote` says why: a likelihood ratio needs a measured
/// P(E|H), and for the first three hypotheses the evidence defines the hypothesis rather than
/// bearing on it, which would make any update circular. It is a column rather than an omission
/// so that it can be filled once matured outcomes exist to measure against.
model InvestigationHypothesis {
  id              String        @id @default(dbgenerated("gen_random_uuid()::text"))
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  /// market, sector, specific or news.
  label     String
  /// The hypothesis in one plain sentence.
  statement String

  /// How often this component has led across every stored attribution row. A measured base
  /// rate, not a declared prior.
  priorBase Float?
  priorNote String?

  /// The measured magnitude supporting it, where one exists: percentage points of the move.
  magnitude     Float?
  /// Evidence for and against, in words. Contradicting is never left empty when something
  /// contradicts it.
  supporting    String
  contradicting String

  /// Null until measured outcomes exist. posteriorNote always states the reason.
  posterior     Float?
  posteriorNote String

  @@unique([investigationId, label])
}

/// The measured facts about one asset on one day, before any rule reads them.
///
/// This exists so the decision rules stop deriving their own numbers. Every field here is
/// arithmetic over stored closes with a published window, computed once by `jobs/factors.py`
/// and read by everything else, which is the only way the panel, the lists and the audit can
/// be made to agree about what a day looked like. Anything a rule needs that is not here is a
/// number some page invented.
///
/// Every field is nullable on purpose. A factor that could not be computed — too few bars, no
/// peers, no volume published — is null and is reported as missing, never zero. Zero is a
/// measurement and the difference matters: a volume ratio of 0 means nothing traded, and a
/// volume ratio of null means nobody looked.
model AssetFactor {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// The session these factors describe, which is the newest close they were computed from.
  periodEnd DateTime @db.Date

  /// Simple returns over 1, 5 and 20 sessions, in percent.
  r1  Float?
  r5  Float?
  r20 Float?

  /// How unusual r1 is against this asset's own history, as a robust z-score: the median and
  /// the median absolute deviation rather than mean and standard deviation, because one
  /// earnings gap in the window otherwise widens the band enough to call every later move
  /// ordinary. The same statistic `jobs/human.py` uses on news rates.
  returnZ     Float?
  /// Volume as a multiple of its own 20-session average. Null when the venue publishes no
  /// volume, which is different from a quiet day.
  volumeRatio Float?

  /// The median 20-session return across this asset's peer group, and this asset minus it.
  /// A name up 4% in an industry up 6% is a laggard, and absolute return alone cannot say so.
  peerMedianR20 Float?
  relStrength   Float?
  /// How many peers that median was taken over. Below the floor in jobs/factors.py the two
  /// fields above are null rather than computed from three names.
  peers         Int    @default(0)

  /// Where the close sits against its own averages and its own range.
  sma20       Float?
  sma50       Float?
  /// Position in the trailing range, 0 at the low and 100 at the high.
  rangePct    Float?
  /// How far below the trailing high, in percent. Always <= 0.
  drawdownPct Float?

  /// Sessions until the next dated item, when one is stored. Context for the rules, never a
  /// direction on its own.
  eventInDays Int?
  /// Distinct stories in the recent window, after the junk filter. Null means news was never
  /// checked for this asset, which the rules report differently from checked-and-none.
  newsStories Int?

  /// How many closes everything above was computed from. A reader cannot judge a 20-session
  /// return taken over 22 bars, and the rules use this to refuse a factor rather than trust it.
  bars   Int
  source String

  computedAt DateTime @default(now())

  @@unique([assetId, periodEnd])
  @@index([periodEnd])
}

/// One past day that resembled today, kept by name.
///
/// `AssetAnalog` stores the aggregate — how many matched, the median, the range. That is the
/// number a reader needs and it is also the number that hides a disagreement: two clusters of
/// past days pointing opposite ways average to "flat", and nothing in the aggregate says so.
/// This table keeps the closest few matches individually, with the date, so the aggregate can
/// be argued with.
///
/// `differences` is the field that earns the table. A day matched on return, volume and
/// five-day trend can still be nothing like today — a different rate regime, a different
/// index level, a gap the model does not carry — and a pattern system that never records what
/// was different is one that will keep insisting history repeats.
model AnalogMatch {
  id       String      @id @default(dbgenerated("gen_random_uuid()::text"))
  analogId String
  analog   AssetAnalog @relation(fields: [analogId], references: [id], onDelete: Cascade)

  /// The past session this row points at.
  matchedOn DateTime @db.Date
  /// How close it was, in the matcher's own units. Smaller is closer; the unit is published
  /// in jobs/analogs.py rather than implied here.
  distance  Float
  /// Rank by distance, 1 being the closest. Only the top few are kept.
  rank      Int

  /// What followed that day over the analog's own horizon, in percent.
  nextPct Float?

  /// What was NOT alike, in plain words, or "nothing recorded" when the matcher found nothing
  /// to flag. Never empty: a match with no stated difference is a claim that two days were the
  /// same, and that claim has to be made explicitly or not at all.
  differences String

  computedAt DateTime @default(now())

  @@unique([analogId, matchedOn])
  @@index([analogId, rank])
}

/// Every decision the rules produced, and what actually happened next.
///
/// The site cannot claim a hit rate it has not measured, and it cannot measure one without
/// writing down what it said at the time. This is that record: the action, the gate that
/// produced it, the levels, and a snapshot of the factors it was read from — so a later
/// argument about why a call was made is settled by the row rather than by rerunning today's
/// code against today's data, which would answer a different question.
///
/// The measured columns fill in on a schedule: +1, +5 and +20 sessions. Nothing is published
/// from them until a minimum sample has matured, and `jobs/accuracy.py` owns that floor.
model DecisionLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// The session the decision was made on.
  periodEnd DateTime @db.Date

  /// LONG, SHORT or WAIT.
  action     String
  /// Which gate decided, e.g. "stale", "mixed-horizons", "long". Stored because a hit rate
  /// over all WAITs is meaningless and a hit rate per gate is the thing worth reading.
  gate       String
  /// High, Medium or Low, as published at the time.
  confidence String

  entryLow     Float?
  entryHigh    Float?
  invalidation Float?

  /// Reward against risk as the deciding setup's own target measured it, at the moment the
  /// decision was taken. Null when no target was stored, which is a common and real state.
  ///
  /// Stored rather than recomputed because this is the number two new rules act on — gate 5's
  /// bypass of a disagreeing horizon and gate 8's promotion of a withheld trend, both at
  /// `ASYMMETRY_CLEARS` — and `jobs/horizons.py` rewrites `SetupTarget` every run. Reading it
  /// back from that table in a month would answer "what is the reward now", where the only
  /// question worth asking of an outcome log is "what was the reward when the call was made".
  ///
  /// With it, the measured columns below answer whether the asymmetry bar is set in the right
  /// place: group the matured rows by whether this cleared 2.0 and compare the moves. Without
  /// it, the threshold could never be checked against anything, which is the state principle 7
  /// exists to forbid.
  rewardRisk Float?

  /// The share of matched past days that went the decided way, and how many were matched.
  ///
  /// Two columns and never one. A share without its denominator cannot be weighed — principle 3
  /// — and a log that stored 0.62 with no count would be unanalysable for exactly the reason the
  /// pages never print one without the other. Both null together below the 8 matches
  /// `jobs/analogs.py` refuses to grade a set under.
  baseRateShare Float?
  baseRateCount Int?

  /// The factor row this was read from, so the snapshot is a reference rather than a copy
  /// that can drift from the table it came from.
  factorId    String?
  /// The analog rows cited, comma separated. Kept as text rather than a relation because the
  /// citation is a historical fact about one decision and must not change when an analog is
  /// recomputed.
  analogRefs  String  @default("")
  /// Sessions to the next dated item at the time of the decision, when one was stored.
  eventInDays Int?

  /// The close the move is measured from.
  baseClose Float?

  move1Pct     Float?
  measured1On  DateTime? @db.Date
  move5Pct     Float?
  measured5On  DateTime? @db.Date
  move20Pct    Float?
  measured20On DateTime? @db.Date

  /// open, measured1, measured5, measured20, or unmeasurable.
  status String @default("open")

  computedAt DateTime @default(now())

  @@unique([assetId, periodEnd])
  @@index([status, periodEnd])
  @@index([gate, status])
}


/// One slice of one job, and how it went.
///
/// The pipeline is many small jobs rather than one long one, and the price of that is that
/// "did the data arrive" stops being answerable by looking at whether a single run was green.
/// This table is the answer instead: every chunk of every source writes one row saying what it
/// touched, how much it wrote, how fresh the result is and whether it failed. The freshness
/// panel reads it, and a failed chunk is a row rather than something to go hunting for in a
/// log that needs a sign-in to read.
///
/// It is deliberately not `Coverage`. Coverage answers "is this source healthy right now",
/// computed by jobs/audit.py from the data itself; this answers "what did the 14:00 crypto
/// slice actually do". A source can be healthy while a chunk failed, and a chunk can succeed
/// while the source is stale — both facts are worth having, and collapsing them into one table
/// is how a green run ends up meaning nothing.
model ChunkRun {
  id String @id @default(dbgenerated("gen_random_uuid()::text"))

  /// The workflow or job that ran, e.g. "cron-crypto", "cron-us-prices".
  job String
  /// The source this slice fetched from, e.g. "Binance", "Yahoo Finance", "Google News RSS".
  /// A chain writes the venue that actually answered, not the chain.
  source String
  /// Which slice, as "3/8". A job that is not chunked writes "1/1" rather than null, so the
  /// column never has to be read as "unknown or not applicable".
  chunk String @default("1/1")

  /// How many rows this slice wrote. Zero is a legitimate answer on a rerun inside a cache
  /// window and is not by itself a failure; `status` carries that judgement.
  rowsWritten Int @default(0)
  /// How many items it asked for, so a slice that wrote 0 of 30 reads differently from one
  /// that wrote 0 of 0.
  asked Int @default(0)
  /// The newest date now stored for this source after the slice, when the slice touched
  /// anything dated. This is the number the staleness rules care about.
  newest DateTime?

  /// ok, partial, empty, or failed. `empty` is "asked for things and got none", which is the
  /// state that must be loud; `partial` is "some answered", which is ordinary and worth
  /// recording so a pattern of partials is visible before it becomes an outage.
  status String
  /// One line a human can read without opening a log. Required: a failed chunk with no note
  /// is the thing this table exists to stop.
  note String

  durationMs Int      @default(0)
  startedAt  DateTime @default(now())

  @@index([job, startedAt])
  @@index([status, startedAt])
  @@index([source, startedAt])
}

