# Neon Postgres connection string. Copy this file to .env and paste the real value.
# The data jobs and the Next.js app both read this one variable.
# In Postgres, Neon console -> Connect, and use the pooled connection string on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional, and only the migration uses it: the same database over Neon's **direct** endpoint,
# i.e. the host above without `-pooler`. `prisma migrate deploy` holds a session-level advisory
# lock, and a transaction pooler returns the connection to the pool still holding it, which
# fails the next migration with P1002. Leave this unset and the schema lane derives it by
# removing `-pooler` itself; set it when the direct host is not simply that.
DIRECT_DATABASE_URL=""

# Optional. Used by jobs/prices.py when filing identified requests with the SEC.
# Leave empty if you do not file any.
CONTACT_EMAIL=""

# Optional standbys for read failover. Both are connection strings for a database that holds a copy of
# the primary, kept current by `jobs/mirror.py`. Unset means no failover, which is the default. They
# are tried in this order after DATABASE_URL: the second Neon project first, Supabase last. Read in
# exactly one place (lib/db.ts), never logged, and never used for a write.
DATABASE_URL_FALLBACK=""

# Supabase: use the **Session pooler** string from Connect in the dashboard (port 5432), not the
# direct host. The direct host is IPv6-only on the free tier, which neither this machine nor GitHub's
# runners reach. Leave out any ssl parameter: the web app adds the one the Node driver needs, and
# Python's driver rejects it.
SUPABASE_DATABASE_URL=""

